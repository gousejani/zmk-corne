#include <behaviors.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/behaviors.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

// cursor speed

#define ZMK_MOUSE_DEFAULT_MOVE_VAL 3000  // 600

// scroll speed

#define ZMK_MOUSE_DEFAULT_SCRL_VAL 20    // 10

// mouse move behavior

&mmv {
    time-to-max-speed-ms = <200>;
    delay-ms = <0>;
};

/ {
    behaviors {
        my_mt: my_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <300>;
            bindings = <&kp>, <&kp>;

            display-name = "My-Mod-Tap";
        };

        my_lt: my_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <400>;
            bindings = <&mo>, <&kp>;
            display-name = "My-Layer-Tap";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // | TAB  |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | ESC  |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  |  '   |
            //                    | OPT | CTRL | CMD |   | RET | CAPS | RSE |

            bindings = <
&kp TAB     &kp Q              &kp W                  &kp E                  &kp R             &kp T        &kp Y      &kp U            &kp I                   &kp O                   &kp P                  &kp BSPC
&kp ESCAPE  &kp A              &kp S                  &kp D                  &my_mod_tap LSHFT F             &kp G        &kp H      &my_mod_tap RSHFT J            &kp K                   &kp L                   &kp SEMI               &kp SQT
&kp LSHFT   &kp Z              &kp X                  &kp C                  &kp V             &kp B        &kp N      &kp M            &kp COMMA               &kp DOT                 &kp FSLH               &kp QUESTION
                                                      &kp LEFT_ALT            &kp LEFT_CONTROL &kp LEFT_COMMAND    &my_lt 1 SPACE  &my_lt 2 RET          &to 1
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5    &kp N6          &kp N7          &kp N8  &kp N9     &kp N0  &kp BSPC
&none    &none   &none   &none   &none   &none     &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP  &kp RIGHT  &none   &none
&none    &none   &none   &none   &none   &none     &none           &none           &none   &none      &none   &none
                         &to 0   &trans  &trans    &trans          &trans          &to 2
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp GRAVE       &kp EXCL   &kp AT    &kp HASH   &kp DLLR   &kp PRCNT    &kp CARET  &kp AMPS        &kp ASTRK        &kp LPAR  &kp RPAR  &kp BSPC
&none           &kp MINUS  &kp PLUS  &kp EQUAL  &kp UNDER  &none        &kp GRAVE  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp LBKT  &kp RBKT  &kp PIPE
&kp LEFT_SHIFT  &none      &none     &none      &none      &none        &kp TILDE  &kp LPAR        &kp RPAR         &kp LT    &kp GT    &kp BACKSLASH
                                     &to 1      &trans     &trans       &trans     &trans          &to 3
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        connection_layer {
            // -----------------------------------------------------------------------------------------
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   |     |     |     |     |     |     |
            // |      |     |     |     |     |     |   |     |     |     |     |     |     |
            // |      |     |     |     |     |     |   |     |     |     |     |     |     |
            //                    | LWR |     |     |   |     |     | RSE |

            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &none   &none   &none  &none  &none  &none
&none       &none         &none         &none         &none         &none           &none   &none   &none  &none  &none  &none
&none       &none         &none         &none         &none         &none           &none   &none   &none  &none  &none  &none
                                        &to 2         &trans        &trans          &trans  &trans  &to 0
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};
